{
  "realm": "argus",
  "enabled": true,
  "displayName": "Argus Engine (local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "argus-admin", "description": "Tenant administrator" },
      { "name": "argus-operator", "description": "Can request and approve actions" },
      { "name": "argus-viewer", "description": "Read-only topology access" }
    ]
  },
  "users": [
    {
      "username": "demo",
      "email": "demo@argus.local",
      "firstName": "Demo",
      "lastName": "Engineer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "argus-demo", "temporary": false }],
      "realmRoles": ["argus-admin"]
    }
  ],
  "clients": [
    {
      "clientId": "argus-web",
      "name": "Argus web (BFF)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/api/auth/callback/*"],
      "webOrigins": ["http://localhost:3000"],
      "secret": "argus-web-local-secret"
    },
    {
      "clientId": "argus-api",
      "name": "Argus API audience",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "secret": "argus-api-local-secret"
    }
  ]
}
