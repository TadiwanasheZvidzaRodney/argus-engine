# Argus Engine — local development configuration.
# Copy to `.env` (never commit `.env`). Values below match docker-compose.yml.

ARGUS_ENV=local
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_FORMAT=json

# --- Edge / API ---
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8000
ARGUS_WS_PORT=8001
ARGUS_PUBLIC_BASE_URL=http://localhost:3000
ARGUS_CORS_ORIGINS=["http://localhost:3000"]
ARGUS_CURSOR_SECRET=local-dev-cursor-secret-change-me
ARGUS_IDEMPOTENCY_TTL_SECONDS=86400

# --- PostgreSQL ---
ARGUS_DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
ARGUS_DATABASE_ADMIN_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus

# --- Neo4j ---
ARGUS_NEO4J_URI=bolt://localhost:7687
ARGUS_NEO4J_USER=neo4j
ARGUS_NEO4J_PASSWORD=argus-local-password

# --- Redis ---
ARGUS_REDIS_URL=redis://localhost:6379/0
ARGUS_QUEUE_URL=redis://localhost:6379/1

# --- Auth (Keycloak in local dev; see infra/local/keycloak) ---
ARGUS_OIDC_ISSUER=http://localhost:8080/realms/argus
ARGUS_OIDC_AUDIENCE=argus-api
ARGUS_OIDC_JWKS_URL=http://localhost:8080/realms/argus/protocol/openid-connect/certs
ARGUS_AUTH_MODE=stub

# --- AWS (LocalStack) ---
ARGUS_AWS_REGION=us-east-1
ARGUS_AWS_ENDPOINT_URL=http://localhost:4566
ARGUS_AWS_ACCESS_KEY_ID=test
ARGUS_AWS_SECRET_ACCESS_KEY=test

# --- Observability ---
ARGUS_OTEL_ENABLED=false
ARGUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
ARGUS_OTEL_SAMPLE_RATIO=1.0
ARGUS_SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8001
